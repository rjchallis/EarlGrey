// conf/variants.config — AB Testing Variant Profiles
//
// This file defines alternative configurations for comparing tool versions,
// parameters, and strategies. Use with:
//   nextflow run main.nf --variant<variant_name> [other options]
//
// Currently supported variants:
//   - default          : standard configuration
//   - repeatmasker_v4_1 : RepeatMasker version 4.1.x
//   - repeatmodeler_fast : RepeatModeler with reduced rounds
//   - high_sensitivity  : conservative repeat detection
//   - low_sensitivity   : aggressive/quick repeat detection
//
// Adding new variants: create a conditional block below with unique parameter overrides

switch(params.variant) {

    case 'default':
        log.info "Using default RepeatMasker/RepeatModeler configuration"
        params {
            rm_version       = '4.1.2'
            rm_dfam_version  = '3.9'
            rm_engine        = 'rmblast'
            rm_sensitive     = false

            rmod_version     = '2.0.7'
            rmod_max_rounds  = 3
            rmod_sample_size = 40_000_000

            skip_repeatmodeler = false
            skip_divergence    = false
        }
        break

    case 'repeatmasker_v4_0':
        log.info "Using RepeatMasker v4.0.x configuration (legacy)"
        params {
            rm_version       = '4.0.9'
            rm_dfam_version  = '3.7'
            rm_engine        = 'crossmatch'  // older default
            rm_sensitive     = false

            rmod_version     = '2.0.7'
            rmod_max_rounds  = 3
            rmod_sample_size = 40_000_000

            skip_repeatmodeler = false
            skip_divergence    = false
        }
        break

    case 'repeatmodeler_fast':
        log.info "Using fast RepeatModeler profile (1 round only)"
        params {
            rm_version       = '4.1.2'
            rm_dfam_version  = '3.9'
            rm_engine        = 'rmblast'
            rm_sensitive     = false

            rmod_version     = '2.0.7'
            rmod_max_rounds  = 1    // Fast: 1 round instead of 3
            rmod_sample_size = 20_000_000  // Reduced sample

            skip_repeatmodeler = false
            skip_divergence    = false
        }
        break

    case 'repeatmodeler_thorough':
        log.info "Using thorough RepeatModeler profile (5 rounds)"
        params {
            rm_version       = '4.1.2'
            rm_dfam_version  = '3.9'
            rm_engine        = 'rmblast'
            rm_sensitive     = true   // Enable sensitive mode

            rmod_version     = '2.0.7'
            rmod_max_rounds  = 5     // Thorough: 5 rounds
            rmod_sample_size = 40_000_000

            skip_repeatmodeler = false
            skip_divergence    = false
        }
        break

    case 'high_sensitivity':
        log.info "Using high sensitivity RepeatMasker profile"
        params {
            rm_version       = '4.1.2'
            rm_dfam_version  = '3.9'
            rm_engine        = 'rmblast'
            rm_sensitive     = true  // Enable verbose reporting

            rmod_version     = '2.0.7'
            rmod_max_rounds  = 3
            rmod_sample_size = 40_000_000

            skip_repeatmodeler = false
            skip_divergence    = false
        }
        break

    case 'no_denovo':
        log.info "Skipping RepeatModeler de novo discovery (Dfam only)"
        params {
            rm_version       = '4.1.2'
            rm_dfam_version  = '3.9'
            rm_engine        = 'rmblast'
            rm_sensitive     = false

            skip_repeatmodeler = true  // Skip de novo
            skip_divergence    = false
        }
        break

    case 'minimal':
        log.info "Minimal profile: Dfam masking only, no de novo, no divergence"
        params {
            rm_version  = '4.1.2'
            skip_repeatmodeler = true
            skip_divergence    = true
        }
        break

    default:
        log.warn "Unknown variant '${params.variant}'; using default configuration"
        params {
            rm_version       = '4.1.2'
            rm_dfam_version  = '3.9'
            rm_engine        = 'rmblast'
            rm_sensitive     = false

            rmod_version     = '2.0.7'
            rmod_max_rounds  = 3
            rmod_sample_size = 40_000_000

            skip_repeatmodeler = false
            skip_divergence    = false
        }
}

// ============================================================================
// Template for adding new variants:
// ============================================================================
//
// case 'my_new_variant':
//     log.info "Using my custom variant profile"
//     params {
//         rm_version       = '4.1.2'
//         rm_dfam_version  = '3.9'
//         rmod_version     = '2.0.7'
//         rmod_max_rounds  = 3
//         skip_repeatmodeler = false
//         // ... other param overrides
//     }
//     process {
