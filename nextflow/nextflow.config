// nextflow.config — EarlGrey DSL2 Nextflow Pipeline Configuration
// Follows nf-core conventions for profiles, resource definitions, and execution settings

manifest {
    name            = 'EarlGrey'
    author          = 'EarlGrey Team'
    homePage        = 'https://github.com/TobyBaril/EarlGrey'
    description     = 'Transposable Element Annotation and Classification Pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.10.3'
    version         = '2.0.0-nextflow'
}

// ============================================================================
// Global defaults & execution
// ============================================================================

process {
    shell = [ '/bin/bash', '-euo', 'pipefail' ]

    // Standard resource requests (overridden per profile)
    cpus   = { check_max( 1 * task.attempt, 'cpus' ) }
    memory = { check_max( 6.GB * task.attempt, 'memory' ) }
    time   = { check_max( 2.h * task.attempt, 'time' ) }

    // Error strategy
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'
}

// Advanced process options (nf-core pattern)
if (params.enable_conda) {
    conda.enabled = true
}

if (params.singularity_pull_docker_container) {
    singularity.autoMounts = true
}

params {
    // Config options
    config_profile_contact = 'EarlGrey Team'
    config_profile_url     = 'https://github.com/TobyBaril/EarlGrey'

    // Input/output
    genome              = ''
    species             = ''
    outdir              = 'results'

    // Computational resources
    threads             = 4
    memory              = '16 GB'
    repeat_type         = 'eukarya'

    // Variant/AB testing configuration
    variant             = 'default'
    variants_config     = "${projectDir}/conf/variants.config"

    // Feature flags
    skip_repeatmodeler  = false
    skip_divergence     = false

    // Help
    help                = false

    // Max resources for limits
    max_cpus     = 16
    max_memory   = 256.GB
    max_time     = 240.h

    // Run name & tracking
    tracedir     = "${params.outdir}/pipeline_info"

    // --- EarlGrey script location -------------------------------------------
    // Path to the EarlGrey scripts/ directory.  Defaults to the sibling
    // directory of the nextflow/ folder inside this repo.
    script_dir = "${projectDir}/../scripts"

    // --- Optional initial masking -------------------------------------------
    // Provide ONE of these to run an initial RepeatMasker pass before de-novo
    // discovery.  Leave both empty to skip this step.
    repeat_species = ''   // RepeatMasker species/taxon string (e.g. 'eukarya')
    custom_lib     = ''   // Path to a user-supplied consensus library FASTA

    // --- TEstrainer parameters ----------------------------------------------
    flank_bases      = 1000  // Flanking bp added per BLAST-Extend-Align cycle
    blast_iterations = 10    // Number of BEAT iterations
    max_sequences    = 20    // Max sequences used to build a consensus
    min_sequences    = 3     // Min sequences required to build a consensus

    // --- Optional post-processing -------------------------------------------
    cluster_library = false  // Cluster TE library with cd-hit-est (80-80-80)
    remove_short    = 'no'   // Remove<100 bp annotations ('yes' / 'no')
    soft_mask       = false  // Generate a soft-masked genome at the end
    heliano         = false  // Run HELIANO to detect Helitrons (RC/Helitron class)

    // Conda/Container defaults
    enable_conda              = false
    singularity_pull_docker_container = false
}

// ============================================================================
// Resource presets per process (nf-core pattern)
// ============================================================================

process {
    withName: 'PREPARE_GENOME' {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h * task.attempt, 'time' ) }
    }

    withName: 'REPEAT_MASK_INITIAL|REPEAT_MASK_FINAL' {
        cpus   = { check_max( params.threads * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 24.h * task.attempt, 'time' ) }
    }

    withName: 'BUILD_DATABASE' {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h * task.attempt, 'time' ) }
    }

    withName: 'DE_NOVO_REPEAT' {
        cpus   = { check_max( params.threads * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 48.h * task.attempt, 'time' ) }
    }

    withName: 'CLUSTER_LIBRARY' {
        cpus   = { check_max( params.threads * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h * task.attempt, 'time' ) }
    }

    withName: 'CLASSIFY_REPEATS' {
        cpus   = { check_max( params.threads * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h * task.attempt, 'time' ) }
    }

    withName: 'MERGE_REPEATS' {
        cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h * task.attempt, 'time' ) }
    }

    withName: 'CALCULATE_DIVERGENCE' {
        cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h * task.attempt, 'time' ) }
    }

    withName: 'HELIANO' {
        cpus   = { check_max( params.threads * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h * task.attempt, 'time' ) }
    }

    withName: 'SOFT_MASK' {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h * task.attempt, 'time' ) }
    }

    withName: 'GENERATE_SUMMARY' {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h * task.attempt, 'time' ) }
    }
}

// ============================================================================
// Execution Profiles (following nf-core conventions)
// ============================================================================

profiles {

    // Development profile (local, low resource)
    dev {
        process {
            executor = 'local'
            cpus     = 2
            memory   = '4 GB'
            time     = '1h'
        }

        params {
            max_cpus   = 2
            max_memory = 4.GB
            max_time   = 1.h
        }
    }

    // Standard HPC profile (cluster submission, moderate resources)
    hpc {
        process {
            executor  = 'lsf'
            queue     = 'normal'
            cpus      = 4
            memory    = '16 GB'
            time      = '24h'

            // LSF job submission options (site-specific)
            // Uncomment and customize for your site:
            // clusterOptions = '-P team301'
            // beforeScript = 'module load earlgrey'
        }

        executor {
            name    = 'lsf'
            queueSize = 100
            submitRateLimit = '1 sec'
            killBatchSize = 100
        }

        params {
            max_cpus   = 16
            max_memory = 256.GB
            max_time   = 240.h
        }
    }

    // HPC profile tuned for Sanger (example site-specific config)
    sanger {
        process {
            executor       = 'lsf'
            queue          = 'oversubscribed'
            cpus           = 4
            memory         = '16 GB'
            time           = '24h'
            clusterOptions = '-P team301'
            // Activate the earlgrey conda env in every sub-job so that
            // RepeatMasker, RepeatModeler, BuildDatabase, etc. are in PATH.
            beforeScript   = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate earlgrey'
        }

        // perJobMemLimit tells Nextflow's LSF executor to submit -M <mem>
        // alongside rusage[mem=<mem>], satisfying the Sanger farm esub check
        // that requires the hard limit and reservation to match exactly.
        executor {
            name             = 'lsf'
            perJobMemLimit   = true
            submitRateLimit  = '5 sec'
            killBatchSize    = 50
        }

        params {
            max_cpus   = 32
            max_memory = 512.GB
            max_time   = 240.h
        }
    }

    // Singularity containerization (can combine with any executor)
    singularity {
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = "${params.outdir}/.singularity"

            // Use pre-built images from nf-core where available
            // This is a placeholder; replace with actual image URIs
            // runOptions = "--bind /lustre"
        }

        // Example container specs (to be populated as modules are created)
        // process.container = 'nf-core/earlgrey:latest'
    }

    // Docker containerization (alternative to Singularity)
    docker {
        docker {
            enabled    = true
            fixOwnership = true
        }
    }

    // Conda environment (alternative to containerization)
    conda {
        params.enable_conda = true
        conda {
            cacheDir   = "${params.outdir}/.conda"
            useMamba   = true
        }
    }

    // Test profile (minimal, for CI/CD)
    test {
        process {
            executor = 'local'
            cpus     = 2
            memory   = '4 GB'
            time     = '30m'
        }

        params {
            max_cpus   = 2
            max_memory = 4.GB
            max_time   = 30.m
        }
    }
}

// ============================================================================
// Trace & metrics collection (nf-core pattern)
// ============================================================================

trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace.txt"
    fields  = 'task_id,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

report {
    enabled = true
    file    = "${params.tracedir}/execution_report.html"
}

timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline.html"
}

dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag.svg"
}

// ============================================================================
// Helper function (nf-core pattern)
// ============================================================================

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "ERROR: invalid max_memory: ${params.max_memory}, using default 256 GB"
            return 256.GB
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "ERROR: invalid max_time: ${params.max_time}, using default 240 hours"
            return 240.h
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj, params.max_cpus as int)
        } catch (all) {
            println "ERROR: invalid max_cpus: ${params.max_cpus}, using default 16"
            return 16
        }
    }
}
